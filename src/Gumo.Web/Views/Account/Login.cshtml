@{
    ViewData["Title"] = "Admin Login";
    var error = ViewBag.Error as string;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <img src="/img/logo.png" alt="GuMo" />
        </div>
        <h1>Admin Login</h1>
        <p class="login-sub">GuMo internal dashboard</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="login-error">@error</div>
        }

        <form method="post" asp-controller="Account" asp-action="Login">
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" placeholder="admin@gumo.de" required autofocus />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-primary" style="width:100%;margin-top:.5rem">
                Sign in →
            </button>
        </form>

        <a href="/" class="login-back">← Back to website</a>
    </div>
</div>

<style>
.login-page {
    min-height: calc(100vh - var(--nav-h));
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-soft); padding: 2rem;
}
.login-card {
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius-lg); padding: 3rem;
    width: 100%; max-width: 400px;
    box-shadow: var(--shadow);
    text-align: center;
}
.login-logo img {
    width: 64px; height: 64px; border-radius: 50%;
    margin: 0 auto 1.5rem;
}
.login-card h1 {
    font-family: var(--font-serif); font-size: 1.75rem; margin-bottom: .25rem;
}
.login-sub { color: var(--muted); font-size: .9rem; margin-bottom: 2rem; }
.login-error {
    background: #fef2f2; border: 1px solid #fca5a5;
    color: #c62828; border-radius: var(--radius);
    padding: .75rem 1rem; font-size: .875rem; margin-bottom: 1.25rem;
    text-align: left;
}
.login-card .form-group { text-align: left; }
.login-back {
    display: block; margin-top: 1.5rem;
    font-size: .85rem; color: var(--muted); transition: color .2s;
}
.login-back:hover { color: var(--dark); }
</style>