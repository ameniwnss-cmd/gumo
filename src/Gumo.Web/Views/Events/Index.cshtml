@model IEnumerable<Gumo.Core.Entities.Event>
@{
    ViewData["Title"] = "Events";
}

<div class="events-page">
    <div class="events-header">
        <h1>Events</h1>
        <p>GuMo brings people together. Join us for our next event.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="no-events">
            <p>No upcoming events right now. Follow us on <a href="https://www.instagram.com/gumo_club/" target="_blank">Instagram</a> to stay updated.</p>
        </div>
    }
    else
    {
        <div class="events-grid">
            @foreach (var ev in Model)
            {
                <a href="@Url.Action("Detail", new { slug = ev.Slug })" class="event-card">
                    <div class="event-card-image">
                        @if (!string.IsNullOrEmpty(ev.ImageFileName))
                        {
                            <img src="/img/events/@ev.ImageFileName" alt="@ev.Title" loading="lazy" />
                        }
                        else
                        {
                            <div class="event-card-placeholder">🎵</div>
                        }
                        @if (ev.AvailableSeats <= 5 && ev.AvailableSeats > 0)
                        {
                            <span class="seats-badge almost-full">Only @ev.AvailableSeats left!</span>
                        }
                        else if (ev.AvailableSeats == 0)
                        {
                            <span class="seats-badge full">Sold Out</span>
                        }
                    </div>
                    <div class="event-card-body">
                        <div class="event-meta">
                            <span class="event-date">📅 @ev.Date.ToString("dddd, MMM d · HH:mm")</span>
                            <span class="event-location">📍 @ev.Location.Name</span>
                        </div>
                        <h2 class="event-title">@ev.Title</h2>
                        @if (!string.IsNullOrEmpty(ev.Description))
                        {
                            <p class="event-desc">@ev.Description</p>
                        }
                        <div class="event-footer">
                            <span class="event-seats">@ev.AvailableSeats / @ev.Capacity seats available</span>
                            <span class="event-cta">Book now →</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>