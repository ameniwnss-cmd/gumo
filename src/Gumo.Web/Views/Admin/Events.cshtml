@model IEnumerable<Gumo.Core.Entities.Event>
@{
    ViewData["Title"] = "Events Management";
    var locations = ViewBag.Locations as IEnumerable<Gumo.Core.Entities.Location>;
}

<div class="admin-page">
    <div class="admin-header">
        <h1>Events Management</h1>
        <div class="admin-nav">
            <a href="@Url.Action("Orders")">Orders</a>
            <a href="@Url.Action("Menu")">Menu</a>
            <a href="@Url.Action("Events")" style="color:var(--dark);border-color:var(--gray)">Events</a>
        </div>
    </div>

    <div style="margin-bottom:1.5rem">
        <button class="btn-primary" onclick="openAddEvent()">+ Create Event</button>
    </div>

    @if (!Model.Any())
    {
        <div class="no-orders"><p>No events yet. Create your first one!</p></div>
    }
    else
    {
        <div class="admin-events-list">
            @foreach (var ev in Model)
            {
                <div class="admin-event-card">
                    <div class="admin-event-info">
                        <div class="admin-event-status">
                            @if (ev.IsPublished)
                            {
                                <span class="badge-published">Published</span>
                            }
                            else
                            {
                                <span class="badge-draft">Draft</span>
                            }
                        </div>
                        <h3>@ev.Title</h3>
                        <p class="admin-event-meta">
                            📅 @ev.Date.ToString("ddd, MMM d, yyyy · HH:mm") &nbsp;·&nbsp;
                            📍 @ev.Location.Name &nbsp;·&nbsp;
                            🎟 @ev.BookedSeats / @ev.Capacity seats booked
                        </p>
                    </div>
                    <div class="admin-event-actions">
                        <a href="@Url.Action("EventBookings", new { eventId = ev.Id })" class="btn-secondary">
                            View bookings (@ev.BookedSeats)
                        </a>
                        <button class="btn-edit" onclick="openEditEvent(@ev.Id, '@Html.Raw(ev.Title.Replace("'","\\'"))', '@Html.Raw((ev.Description ?? "").Replace("'","\\'"))', '@ev.Date.ToString("yyyy-MM-ddTHH:mm")', @ev.Capacity, @ev.LocationId, @ev.IsPublished.ToString().ToLower(), '@(ev.ImageFileName ?? "")')">
                            Edit
                        </button>
                        <button class="btn-delete" onclick="deleteEvent(@ev.Id)">Delete</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Add/Edit Modal -->
<div id="event-modal" class="modal hidden">
    <div class="modal-content" style="text-align:left;max-width:520px">
        <h2 id="event-modal-title" style="font-family:var(--font-serif);margin-bottom:1.5rem">Create Event</h2>
        <input type="hidden" id="event-id" value="0" />
        <input type="hidden" id="event-image-filename" value="" />
        <div class="form-group">
            <label>Event Image</label>
            <div class="upload-area" onclick="document.getElementById('event-image-input').click()">
                <img id="event-image-preview" src="" alt="" class="upload-preview hidden" />
                <div id="event-upload-placeholder" class="upload-placeholder">
                    <span>🖼</span><span>Click to upload event image</span>
                </div>
            </div>
            <input type="file" id="event-image-input" accept="image/*" style="display:none" onchange="handleEventImageUpload(this)" />
            <div id="event-upload-progress" class="hidden" style="font-size:.82rem;color:var(--muted);margin-top:.4rem">Uploading...</div>
        </div>
        <div class="form-group">
            <label>Title *</label>
            <input type="text" id="event-title" placeholder="e.g. GuMo Music Night" />
        </div>
        <div class="form-group">
            <label>Description</label>
            <textarea id="event-desc" placeholder="What's the event about?"></textarea>
        </div>
        <div class="form-group">
            <label>Date & Time *</label>
            <input type="datetime-local" id="event-date" />
        </div>
        <div class="form-group">
            <label>Capacity *</label>
            <input type="number" id="event-capacity" min="1" placeholder="50" />
        </div>
        <div class="form-group">
            <label>Location *</label>
            <select id="event-location">
                @foreach (var loc in locations!)
                {
                    <option value="@loc.Id">@loc.Name</option>
                }
            </select>
        </div>
        <div style="margin-bottom:1.25rem">
            <label style="display:flex;align-items:center;gap:.5rem;cursor:pointer">
                <input type="checkbox" id="event-published" checked /> Publish immediately
            </label>
        </div>
        <div style="display:flex;gap:1rem">
            <button class="btn-primary" onclick="saveEvent()">Save</button>
            <button class="btn-secondary" onclick="closeEventModal()">Cancel</button>
        </div>
        <div id="event-modal-error" class="error-msg hidden"></div>
    </div>
</div>

@section Scripts {
<script>
    function resetEventImage(existingImg) {
        document.getElementById('event-image-filename').value = existingImg || '';
        document.getElementById('event-image-input').value = '';
        const preview = document.getElementById('event-image-preview');
        const placeholder = document.getElementById('event-upload-placeholder');
        if (existingImg) {
            preview.src = '/img/events/' + existingImg;
            preview.classList.remove('hidden');
            placeholder.classList.add('hidden');
        } else {
            preview.src = '';
            preview.classList.add('hidden');
            placeholder.classList.remove('hidden');
        }
    }

    async function handleEventImageUpload(input) {
        if (!input.files[0]) return;
        const progress = document.getElementById('event-upload-progress');
        progress.classList.remove('hidden');
        const formData = new FormData();
        formData.append('file', input.files[0]);
        formData.append('folder', 'events');
        const res = await fetch('@Url.Action("UploadImage")', { method: 'POST', body: formData });
        progress.classList.add('hidden');
        if (res.ok) {
            const data = await res.json();
            document.getElementById('event-image-filename').value = data.fileName;
            const preview = document.getElementById('event-image-preview');
            preview.src = '/img/events/' + data.fileName;
            preview.classList.remove('hidden');
            document.getElementById('event-upload-placeholder').classList.add('hidden');
        } else {
            alert('Image upload failed. Please try again.');
        }
    }

    function nowLocalISO() {
        return new Date(Date.now() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    }

    function openAddEvent() {
        document.getElementById('event-modal-title').textContent = 'Create Event';
        document.getElementById('event-id').value = 0;
        document.getElementById('event-title').value = '';
        document.getElementById('event-desc').value = '';
        document.getElementById('event-date').value = '';
        document.getElementById('event-date').min = nowLocalISO();
        document.getElementById('event-capacity').value = '';
        document.getElementById('event-published').checked = true;
        document.getElementById('event-modal-error').classList.add('hidden');
        resetEventImage(null);
        document.getElementById('event-modal').classList.remove('hidden');
    }

    function openEditEvent(id, title, desc, date, capacity, locationId, isPublished, imageFileName) {
        document.getElementById('event-modal-title').textContent = 'Edit Event';
        document.getElementById('event-id').value = id;
        document.getElementById('event-title').value = title;
        document.getElementById('event-desc').value = desc;
        document.getElementById('event-date').value = date;
        document.getElementById('event-date').min = nowLocalISO();
        document.getElementById('event-capacity').value = capacity;
        document.getElementById('event-location').value = locationId;
        document.getElementById('event-published').checked = isPublished;
        document.getElementById('event-modal-error').classList.add('hidden');
        resetEventImage(imageFileName || null);
        document.getElementById('event-modal').classList.remove('hidden');
    }

    function closeEventModal() {
        document.getElementById('event-modal').classList.add('hidden');
    }

    async function saveEvent() {
        const title = document.getElementById('event-title').value.trim();
        const date = document.getElementById('event-date').value;
        const capacity = parseInt(document.getElementById('event-capacity').value);
        const errorEl = document.getElementById('event-modal-error');

        if (!title || !date || isNaN(capacity)) {
            errorEl.textContent = 'Title, date and capacity are required.';
            errorEl.classList.remove('hidden');
            return;
        }
        const selectedTimestamp = new Date(date).getTime();
        const nowTimestamp = Date.now();
        if (isNaN(selectedTimestamp) || selectedTimestamp <= nowTimestamp) {
            errorEl.textContent = '⚠️ Event date must be in the future.';
            errorEl.classList.remove('hidden');
            document.getElementById('event-date').focus();
            return;
        }
        const res = await fetch('@Url.Action("SaveEvent")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                id: parseInt(document.getElementById('event-id').value),
                title,
                description: document.getElementById('event-desc').value.trim() || null,
                date: new Date(date).toISOString(),
                capacity,
                locationId: parseInt(document.getElementById('event-location').value),
                isPublished: document.getElementById('event-published').checked,
                imageFileName: document.getElementById('event-image-filename').value || null
            })
        });
        if (res.ok) { closeEventModal(); window.location.reload(); }
        else {
            const err = await res.json().catch(() => ({ error: 'Failed to save. Please try again.' }));
            errorEl.textContent = '⚠️ ' + (err.error ?? 'Failed to save. Please try again.');
            errorEl.classList.remove('hidden');
        }
    }

    async function deleteEvent(id) {
        if (!confirm('Delete this event and all its bookings? This cannot be undone.')) return;
        const res = await fetch('@Url.Action("DeleteEvent")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'id=' + id
        });
        if (res.ok) window.location.reload();
    }

    document.getElementById('event-modal').addEventListener('click', function(e) {
        if (e.target === this) closeEventModal();
    });
</script>
}